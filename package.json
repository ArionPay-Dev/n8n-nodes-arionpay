{
  "name": "n8n-nodes-arionpay",
  "version": "2.0.0",
  "description": "ArionPay crypto payments for n8n: create and read invoices, and check signed payment webhooks received by n8n's Webhook node. Money goes straight to your own wallet.",
  "keywords": ["n8n-community-node-package", "arionpay", "crypto", "bitcoin", "usdt", "payments"],
  "license": "MIT",
  "homepage": "https://arionpay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArionPay-Dev/n8n-nodes-arionpay.git"
  },
  "bugs": "https://github.com/ArionPay-Dev/n8n-nodes-arionpay/issues",
  "author": { "name": "ArionPay", "email": "info@arionpay.com", "url": "https://arionpay.com" },
  "main": "index.js",
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-icons.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/ArionPayApi.credentials.js"],
    "nodes": ["dist/nodes/ArionPay/ArionPay.node.js"]
  },
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "~5.6.3",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
